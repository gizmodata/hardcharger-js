{
  "name": "@gizmodata/hardcharger",
  "version": "2.0.0",
  "description": "JavaScript/TypeScript client for Hardcharger\u2122, GizmoData\u2122's DuckDB 2.0 server: hardcharger:// URLs on the Warp SQL client, for Node, browsers, Deno, Bun and edge runtimes.",
  "author": "GizmoData LLC",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gizmodata/hardcharger-js.git"
  },
  "homepage": "https://github.com/gizmodata/hardcharger-js#readme",
  "keywords": [
    "hardcharger",
    "warp-sql",
    "gizmodata",
    "duckdb",
    "arrow",
    "apache-arrow",
    "sql"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "warp-sql": "scripts/install-warp-sql.sh",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "eslint . && prettier --check . && node scripts/check-lock.mjs",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:browser": "playwright test --config test/browser/playwright.config.ts",
    "test:examples": "node scripts/run-examples.mjs",
    "check:package": "node scripts/check-package.mjs && publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "node scripts/guard-publish.mjs"
  },
  "peerDependencies": {
    "apache-arrow": "^21.2.0"
  },
  "dependencies": {
    "@gizmodata/warp-sql": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "apache-arrow": "^21.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
